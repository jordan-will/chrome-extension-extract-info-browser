{
    "manifest_version": 3,
    "name": "Page Collector",
    "version": "1.0.0",
    "description": "Collect information from currently active webpage",
    
    "action":{
        "default_popup": "popup.html",
        "default_title": "Page collector"
    },

    "background": {
        "service_worker": "background.js"
    },

    "permissions":[
        "activeTab",
        "scripting"
    ]
}